{
  "plugins": ["typescript", "import", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "dist",
    "shots",
    "art/candidates",
    "src/assets",
    "**/*.generated.*"
  ],
  "rules": {
    "import/no-named-as-default-member": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["__pm", "__BUILD_STAMP__"]
      }
    ]
  }
}
