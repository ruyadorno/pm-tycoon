{
  "name": "pm-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Package Management Tycoon — a mobile-first pixel-art isometric tycoon game",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . && node tools/check-sim-purity.mjs",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "node tools/sim/cli.ts",
    "sim:gate": "node tools/sim/cli.ts --gate --seeds 1-10 --minutes 30",
    "e2e:install": "node tools/e2e-install.mjs",
    "e2e": "node tools/e2e-available.mjs && vite build && playwright test",
    "e2e:smoke": "node tools/e2e-available.mjs && vite build && playwright test e2e/smoke.spec.ts e2e/dist.spec.ts",
    "shots": "node tools/e2e-available.mjs && vite build && playwright test e2e/shots.spec.ts",
    "audio:render": "node tools/e2e-available.mjs && vite build && playwright test e2e/audio-render.spec.ts",
    "audio:vendor": "node tools/audio/vendor.mjs",
    "font:build": "node tools/art/font.ts",
    "art:palette": "node --env-file-if-exists=.env tools/art/build.ts palette",
    "art:draw": "node --env-file-if-exists=.env tools/art/build.ts draw",
    "art:gen": "node --env-file-if-exists=.env tools/art/build.ts gen",
    "art:normalize": "node --env-file-if-exists=.env tools/art/build.ts normalize",
    "art:quantize": "node --env-file-if-exists=.env tools/art/build.ts quantize",
    "art:outline": "node --env-file-if-exists=.env tools/art/build.ts outline",
    "art:variants": "node --env-file-if-exists=.env tools/art/build.ts variants",
    "art:lint": "node --env-file-if-exists=.env tools/art/build.ts lint",
    "art:atlas": "node --env-file-if-exists=.env tools/art/build.ts atlas",
    "art:gallery": "node --env-file-if-exists=.env tools/art/build.ts gallery",
    "art:approve": "node --env-file-if-exists=.env tools/art/build.ts approve",
    "art:reject": "node --env-file-if-exists=.env tools/art/build.ts reject",
    "art:balance": "node --env-file-if-exists=.env tools/art/build.ts balance",
    "art:build": "node --env-file-if-exists=.env tools/art/build.ts all",
    "check": "node tools/check.mjs",
    "check:quick": "node tools/check.mjs --quick",
    "bundle": "node tools/bundle.mjs"
  },
  "dependencies": {
    "eventemitter3": "5.0.4",
    "phaser": "4.2.1",
    "smplr": "1.1.0",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "free-tex-packer-core": "0.3.9",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
