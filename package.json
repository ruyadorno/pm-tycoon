{
  "name": "pm-tycoon",
  "version": "0.1.0",
  "private": true,
  "description": "Package Management Tycoon — a mobile-first pixel-art isometric tycoon game",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "eventemitter3": "5.0.4",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "free-tex-packer-core": "0.3.9",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
